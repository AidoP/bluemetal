edition = 2024

rule rust
    command = rustc --color=always --out-dir=target/tmp --emit=link=$out --emit=metadata=$out.rmeta --emit=dep-info=$depfile --crate-type=$crate-type --crate-name=$crate-name --edition=$edition $flags $in
    deps = gcc
    depfile = $out.d

rule configure
    command = target/configure $in $out
    description = CONFIGURE $out
    pool = console
    deps = gcc
    depfile = $out.d

build target/configure: rust dev/configure/main.rs
    crate-type = bin
    crate-name = configure

build target/test-configure: rust dev/configure/main.rs
    crate-type = bin
    crate-name = test_configure
    flags = --test

# integration tests, which run target/configure from the working directory, so run them from the project root
build target/test/dev/configure: rust test/dev/configure/main.rs || target/configure
    crate-type = bin
    crate-name = test_dev_configure
    flags = --test

build build.ninja: configure Build | target/configure
