# Builds the configure tool and the first `build.ninja`, with `ninja -f bootstrap.ninja`. After that, `build.ninja`
# rebuilds the configure tool and regenerates itself, so this is not needed again.

rule rustc
    command = rustc --color=always --out-dir=target/tmp --emit=link=$out --emit=dep-info=$out.d --crate-type=bin --crate-name=configure --edition=2024 $in
    description = RUSTC $out
    deps = gcc
    depfile = $out.d

rule configure
    command = target/configure $in $out
    description = CONFIGURE $out
    pool = console
    deps = gcc
    depfile = $out.d
    generator = 1

build target/configure: rustc dev/configure/main.rs

build build.ninja: configure Build | target/configure
